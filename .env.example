# --- Obligatorio en producción, opcional en local ---
# Secreto para firmar la cookie de sesión (mín. 32 caracteres). En local hay un valor por defecto.
SESSION_SECRET=

# --- IA que lee los documentos (Gemini o Claude) ---
# Sin ninguna clave la app funciona, pero cada documento subido queda en "revisión manual".
# Opcional: forzar proveedor (gemini | claude). Sin esto se usa el que tenga clave, Gemini primero.
# IA_PROVEEDOR=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MODEL_RESPALDO=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Base de datos ---
# Vacío = Postgres embebido (PGlite) en ./.data/pgdata, sin instalar nada.
# Producción (Supabase): Project Settings → Database → Connection string (URI, modo "Session").
DATABASE_URL=

# --- Almacenamiento de archivos ---
# Vacío = disco local en ./.data/uploads.
# Producción (Supabase Storage): crea un bucket privado y completa estas tres variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documentos
