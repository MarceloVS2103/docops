# --- Obligatorio en producción, opcional en local ---
# Secreto para firmar la cookie de sesión (mín. 32 caracteres). En local hay un valor por defecto.
SESSION_SECRET=

# --- IA / OCR (Claude API) ---
# Sin esta clave la app funciona, pero cada documento subido queda en "revisión manual".
ANTHROPIC_API_KEY=
# Opcional: modelo usado para leer documentos (por defecto claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Base de datos ---
# Vacío = Postgres embebido (PGlite) en ./.data/pgdata, sin instalar nada.
# Producción (Supabase): Project Settings → Database → Connection string (URI, modo "Session").
DATABASE_URL=

# --- Almacenamiento de archivos ---
# Vacío = disco local en ./.data/uploads.
# Producción (Supabase Storage): crea un bucket privado y completa estas tres variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documentos
